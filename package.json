{
  "name": "samescale",
  "private": true,
  "version": "0.1.0",
  "description": "Compare the true size of cities, regions, and countries by moving their outlines across the globe.",
  "homepage": "https://samescale.planiverse.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Constantine-Kostikas/samescale.git"
  },
  "bugs": {
    "url": "https://github.com/Constantine-Kostikas/samescale/issues"
  },
  "keywords": [
    "map",
    "true-size",
    "mercator",
    "maplibre",
    "geojson",
    "openstreetmap",
    "vue"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "vue-tsc -b",
    "presets": "node scripts/fetch-presets.mjs",
    "style": "node scripts/fetch-style.mjs"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@mapbox/polyline": "^1.2.1",
    "@turf/area": "^7.4.0",
    "@turf/center-of-mass": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "maplibre-gl": "^6.19.0",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/geojson": "^7946.0.16",
    "@types/mapbox__polyline": "^1.0.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.166.0"
  }
}
